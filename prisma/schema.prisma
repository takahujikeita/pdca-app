// Prisma schema for PDCA App for POSSE

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ユーザーモデル
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  avatar    String?
  role      String   @default("member")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // リレーション
  projectMembers ProjectMember[]
  tasks          Task[]
  evaluations    Evaluation[]
  actions        Action[]
}

// プロジェクトモデル
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      String   @default("planning") // planning, active, completed, suspended
  goals       String // JSON配列として保存
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // リレーション
  members     ProjectMember[]
  tasks       Task[]
  evaluations Evaluation[]
}

// プロジェクトメンバーモデル
model ProjectMember {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  // リレーション
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

// タスクモデル
model Task {
  id             String    @id @default(cuid())
  projectId      String
  title          String
  description    String?
  assigneeId     String
  priority       String    @default("medium") // high, medium, low
  status         String    @default("todo") // todo, in_progress, review, done
  estimatedHours Int?
  actualHours    Int?
  dueDate        DateTime
  dependencies   String? // JSON配列として保存
  tags           String? // JSON配列として保存
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  // リレーション
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee   User        @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  evaluation Evaluation?

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

// 評価モデル
model Evaluation {
  id           String   @id @default(cuid())
  userId       String
  taskId       String?  @unique
  projectId    String?
  targetType   String // task, project, daily
  selfScore    Int
  autoScore    Int?
  comments     String?
  improvements String? // JSON配列として保存
  learnings    String? // JSON配列として保存
  evaluatedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // リレーション
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actions Action[]

  @@index([userId])
  @@index([taskId])
  @@index([projectId])
  @@index([targetType])
}

// 改善アクションモデル
model Action {
  id           String    @id @default(cuid())
  title        String
  description  String?
  assigneeId   String
  evaluationId String
  status       String    @default("planned") // planned, in_progress, completed
  priority     String    @default("medium") // high, medium, low
  impact       String    @default("medium") // high, medium, low
  effort       String    @default("medium") // high, medium, low
  dueDate      DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?

  // リレーション
  assignee   User       @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([assigneeId])
  @@index([evaluationId])
  @@index([status])
}
